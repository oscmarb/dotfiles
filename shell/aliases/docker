#!/bin/bash

# DOCKER
alias dpsa='docker ps -a'
alias dsac='docker stop $(docker ps -a -q)'
alias drac='docker rm $(docker ps -a -q)'
alias drai='docker rmi $(docker images -a -q)'
alias di='docker images'
alias dcn='docker ps --format "{{.Names}}"'

# Usage: _docker_action <prompt> <multi:0|1> <list_cmd> <docker_cmd> [args...]
# If args given, runs docker_cmd directly; otherwise opens fzf with list_cmd output.
_docker_action() {
    local prompt="$1" multi="$2" list_cmd="$3" docker_cmd="$4"
    shift 4

    local cmd_arr
    eval "cmd_arr=($docker_cmd)"

    if (( $# > 0 )); then
        "${cmd_arr[@]}" "$@"
        return
    fi

    local fzf_opts=()
    [[ "$multi" == "1" ]] && fzf_opts+=("-m")

    local selection
    selection=$(eval "$list_cmd" | fzf "${fzf_opts[@]}" --prompt="$prompt" --bind 'tab:toggle')

    [[ -z "$selection" ]] && return 1

    printf '%s\n' "$selection" | xargs "${cmd_arr[@]}"
}

dsc() { _docker_action "Stop container: "    			1 "docker ps --format '{{.Names}}'"                   "docker stop" "$@"; }
drc() { _docker_action "Remove container: "  			1 "docker ps -a --format '{{.Names}}'"                "docker rm"   "$@"; }
dl()  { _docker_action "Container logs: "           0 "docker ps --format '{{.Names}}'"  "docker logs"    "$@"; }
dlf() { _docker_action "Container logs (follow): " 0 "docker ps --format '{{.Names}}'"  "docker logs -f" "$@"; }
dri() { _docker_action "Remove image: "      			1 "docker images --format '{{.Repository}}:{{.Tag}}'" "docker rmi"  "$@"; }

# Arguments: container name & shell type (bash by default)
de() {
    local container=${1:-}
    if [[ -z "$container" ]]; then
        container=$(docker ps --format "{{.Names}}" | fzf --prompt="Exec container: " --bind 'tab:toggle')
        [[ -z "$container" ]] && return 1
    fi
    docker exec -it "$container" "${2:-bash}"
}

# DOCKER COMPOSE
alias dcu='docker-compose up -d'     			# up
alias dcs='docker-compose stop'      			# stop
alias dcb='docker-compose build'     			# build
alias dcbn='docker-compose build --no-cache'    # build --no-cache
alias dcbu='dcb && sleep 1 && dcu'   			# build & up
alias dcbnu='dcbn && sleep 1 && dcu'   			# build --no-cache & up
alias dcsbu='dcs && sleep 1 && dcbu' 			# stop, build & up
alias dcsbnu='dcs && sleep 1 && dcbnu' 			# stop, build --no-cache & up
alias dcr='dcs && sleep 1 && dcu'    			# restart => stop & up

# Argument: container name & shell type (bash by default)
# docker-compose up & exec container
dcue() {
    dcu
    de "$@"
}
