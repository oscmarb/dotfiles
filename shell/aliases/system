#!/bin/bash

alias cl='clear'
alias ray-restart="dot raycast restart"
alias rl="reload"
alias fzfp="fzf --preview '$DOTFILES_PATH/fzf/preview {}'"
alias ubuntu-container='docker run --rm -it ubuntu:latest'

reload() {
  if [[ "$shell" == "zsh" ]]; then
    if [ -d "$HOME/.zshrc" ]; then
      source "$HOME/.zshrc"
    else
      source "$DOTFILES_PATH/shell/zsh/.zshrc"
    fi
  else
    if [ -d "$HOME/.bashrc" ]; then
      source "$HOME/.bashrc"
    else
      source "$DOTFILES_PATH/shell/bash/.bashrc"
    fi
  fi

  tmux source $HOME/.tmux.conf 2>/dev/null || true
}

copy() {
  local output=$("$@")
  printf '%s' "${output%$'\n'}" | pbcopy
}

print_copy() {
  local output=$("$@")
  echo "$output"
  printf '%s' "${output%$'\n'}" | pbcopy
}

make() {
  if [[ "$*" == *"-f"* ]]; then
    /usr/bin/make "$@"
    return $?
  fi

  local no_commit_file_name=$(system::no_commit_file_name "Makefile")

  if [ -f "$no_commit_file_name" ] && /usr/bin/make -f "$no_commit_file_name" -n "$@" &>/dev/null; then
    /usr/bin/make -f "$no_commit_file_name" "$@"
  else
    /usr/bin/make "$@"
  fi
}

shell_performance() {
  local iterations=20
  
  echo "Iterations: $iterations"
  echo ""
  _measure_shell_startup "zsh" $iterations
  echo ""
  _measure_shell_startup "bash" $iterations
}

zsh_shell_performance(){
  local iterations=20
  
  echo "Iterations: $iterations"
  echo ""
  _measure_shell_startup "zsh" $iterations
}

bash_shell_performance(){
  local iterations=20
  
  echo "Iterations: $iterations"
  echo ""
  _measure_shell_startup "bash" $iterations
}

_measure_shell_startup() {
  local shell="$1"
  local iterations="$2"
  
  # Input validation
  if [[ -z "$shell" ]]; then
    echo "Error: Shell name required (bash or zsh)"
    return 1
  fi
  
  if [[ "$shell" != "bash" && "$shell" != "zsh" ]]; then
    echo "Error: Invalid shell. Use 'bash' or 'zsh'"
    return 1
  fi
  
  if [[ ! "$iterations" =~ ^[0-9]+$ ]] || [[ "$iterations" -lt 1 ]]; then
    echo "Error: Iterations must be a positive number"
    return 1
  fi
  
  local measurements=()
  local count=1
  
  # Use TIMEFORMAT to get clean time output
  local original_timeformat="$TIMEFORMAT"
  TIMEFORMAT='%3R'
  
  while [ $count -le $iterations ]; do
    # Measure time and capture stderr (where time output goes)
    local time_output=$( { time $shell -i -c exit; } 2>&1 )
    
    # Check if measurement succeeded
    if [[ -z "$time_output" ]]; then
      echo "Error: Failed to measure iteration $count"
      return 1
    fi
    
    if [[ "$SHELL" == *"zsh"* ]]; then
      if [[ "$shell" == "zsh" ]]; then
        local time_value=$(echo "$time_output" | awk '{print $7}')
      else
        local time_value=$(echo "$time_output" | awk 'NR == 2' | awk '{print $7}')
      fi
    else
      if [[ "$shell" == "zsh" ]]; then
        local time_value="$time_output"
      else
        local time_value=$(echo "$time_output" | awk 'NR == 2')
      fi
    fi

    if [[ -n "$time_value" ]]; then
      measurements+=("$time_value")
    else
      echo "Error: Could not parse time from iteration $count"
      return 1
    fi
    
    ((count++))
  done
  
  # Restore original TIMEFORMAT
  TIMEFORMAT="$original_timeformat"
  
  # Check if we got any valid measurements
  if [[ ${#measurements[@]} -eq 0 ]]; then
    echo "Error: No valid measurements collected"
    return 1
  fi
  
  # Calculate statistics
  local sum=0
  local min=""
  local max=""
  
  for time_val in "${measurements[@]}"; do
    sum=$(awk -v a="$sum" -v b="$time_val" 'BEGIN{printf "%.10f", a + b}')
    
    # Update min
    if [[ -z "$min" ]] || (( $(awk -v a="$time_val" -v b="$min" 'BEGIN{print (a < b)}') )); then
      min="$time_val"
    fi
    
    # Update max
    if [[ -z "$max" ]] || (( $(awk -v a="$time_val" -v b="$max" 'BEGIN{print (a > b)}') )); then
      max="$time_val"
    fi
  done
  
  local average=$(awk -v sum="$sum" -v count="${#measurements[@]}" 'BEGIN{printf "%.3f", sum / count}')
  
  echo "--- Results for $shell ---"
  echo "Average:    ${average}s"
  echo "Min:        ${min}s"
  echo "Max:        ${max}s"
}

loadnvm() {
  if [ -d "$HOME/.nvm" ]; then
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  else
    echo "nvm not installed"
  fi
}

update() {
  system::update
  system::upgrade
  zinit delete --clean
  zinit update
  clear-completions-cache
  reload
}

clear-completions-cache(){
  rm -f ${ZDOTDIR:-$HOME}/.zcompdump*
  autoload -U compinit
  compinit
}

htop() {
  if command -v btm >/dev/null 2>&1; then
    btm "$@"
  else
    /bin/htop "$@"
  fi
}

navialias() {
  navi --query ":: $1" --best-match
}

notify() {
    eval "$@"
    local exit_code=$?
    local cmd="$*"
    set +m
    (
        osascript -e "display notification \"Your command has finished: $cmd\" with title \"Command finished\""
        afplay /System/Library/Sounds/Ping.aiff
    ) &
    disown
    set -m
    open -g "raycast://extensions/raycast/raycast/confetti" 2> /dev/null
    return $exit_code
}


pbcopy() {
  if command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard
  else
    /usr/bin/pbcopy
  fi
}

pbpaste() {
  if command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard -o
  else
    /usr/bin/pbpaste
  fi
}

# Makes all files within a specified directory executable by applying
# the +x permission recursively to each file found.
#
# @param {string} $1 - The directory path to process. Required.
# @return {number} Returns 0 on success, 1 if no directory argument provided.
# @example
#   chrx ./scripts
chrx() {
  if [ -z "$1" ]; then
    echo "Usage: chrx <directory>"
    return 1
  fi

  find "$1" -type f -exec chmod +x {} \;
}
